        <style>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="rows" value="false" />
          </style-rule>
          <style-rule element="axis">
            <format attr="title" scope="cols" value="Share (0–100%)" field="[bay_metrics].[usr:Display rate:qk]" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[bay_metrics].[usr:Display rate:qk]" />
              <color column="[bay_metrics].[none:category_type:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>&lt;[bay_metrics].[none:category:nk]&gt;
Count / denominator: &lt;[bay_metrics].[usr:Count and denominator:nk]&gt;
&lt;[bay_metrics].[none:warning:nk]&gt;
Historical 2023 records; not actual hires or verified unique vacancies.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[bay_metrics].[none:category:nk]</rows>
        <cols>[bay_metrics].[usr:Display rate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Inherited skill percentages">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" bold="true">Inherited skill percentages</run>
          </formatted-text>
        </title>
      </layout-options>
