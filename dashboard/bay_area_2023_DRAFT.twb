            </column>
            <column caption="Role" datatype="string" name="[Role]" param-domain-type="list" role="measure" type="nominal" value="&quot;All roles&quot;">
              <calculation formula="&quot;All roles&quot;" class="tableau" />
              <members>
                <member value="&quot;All roles&quot;" />
                <member value="&quot;Data Analyst&quot;" />
                <member value="&quot;Data Engineer&quot;" />
                <member value="&quot;Data Scientist&quot;" />
                <member value="&quot;Machine Learning Engineer&quot;" />
              </members>
            </column>
            <column caption="Geography view" datatype="string" name="[Geography view]" param-domain-type="list" role="measure" type="nominal" value="&quot;City&quot;">
              <calculation formula="&quot;City&quot;" class="tableau" />
              <members>
                <member value="&quot;County&quot;" />
                <member value="&quot;City&quot;" />
                <member value="&quot;Community&quot;" />
                <member value="&quot;County-only&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter column="[bay_metrics].[none:Selected slice:nk]" class="categorical">
            <groupfilter function="member" level="[none:Selected slice:nk]" member="true" />
          </filter>
          <filter column="[bay_metrics].[none:panel:nk]" class="categorical">
            <groupfilter function="member" level="[none:panel:nk]" member="&quot;coverage&quot;" />
          </filter>
          <filter column="[bay_metrics].[none:category:nk]" class="categorical">
            <groupfilter function="member" level="[none:category:nk]" member="&quot;Usable inherited tags&quot;" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="rows" value="false" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[bay_metrics].[usr:Skill coverage message:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>&lt;[bay_metrics].[none:category:nk]&gt;
Count / denominator: &lt;[bay_metrics].[usr:Count and denominator:nk]&gt;
&lt;[bay_metrics].[none:warning:nk]&gt;
Historical 2023 records; not actual hires or verified unique vacancies.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
  </worksheets>
