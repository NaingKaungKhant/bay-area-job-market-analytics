        <cols>[bay_metrics].[usr:Display rate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Location associations">
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize="12" bold="true">Location associations</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="2023 accepted Bay records — SQL aggregate slices" name="bay_metrics" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="bay_metrics">
            <column datatype="string" name="[scope_key]" role="dimension" type="nominal" />
            <column-instance column="[scope_key]" derivation="None" name="[none:scope_key:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[role_selection]" role="dimension" type="nominal" />
            <column-instance column="[role_selection]" derivation="None" name="[none:role_selection:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[panel]" role="dimension" type="nominal" />
            <column-instance column="[panel]" derivation="None" name="[none:panel:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[category_type]" role="dimension" type="nominal" />
            <column-instance column="[category_type]" derivation="None" name="[none:category_type:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[category]" role="dimension" type="nominal" />
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal" />
            <column datatype="integer" name="[numerator]" role="measure" type="quantitative" aggregation="Sum" />
            <column-instance column="[numerator]" derivation="Sum" name="[sum:numerator:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[denominator]" role="measure" type="quantitative" aggregation="Max" />
            <column-instance column="[denominator]" derivation="Max" name="[max:denominator:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[comparison_allowed]" role="dimension" type="nominal" />
            <column-instance column="[comparison_allowed]" derivation="None" name="[none:comparison_allowed:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[warning]" role="dimension" type="nominal" />
            <column-instance column="[warning]" derivation="None" name="[none:warning:nk]" pivot="key" type="nominal" />
            <column datatype="integer" name="[category_order]" role="dimension" type="nominal" />
            <column-instance column="[category_order]" derivation="None" name="[none:category_order:nk]" pivot="key" type="nominal" />
            <column datatype="real" name="[rate]" role="measure" type="quantitative" aggregation="Max" default-format="p0.0%" />
            <column-instance column="[rate]" derivation="Max" name="[max:rate:qk]" pivot="key" type="quantitative" />
            <column datatype="string" name="[source_revision]" role="dimension" type="nominal" />
            <column-instance column="[source_revision]" derivation="None" name="[none:source_revision:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[cleaning_rule_version]" role="dimension" type="nominal" />
            <column-instance column="[cleaning_rule_version]" derivation="None" name="[none:cleaning_rule_version:nk]" pivot="key" type="nominal" />
            <column caption="Selected slice" datatype="boolean" name="[Selected slice]" role="dimension" type="nominal">
              <calculation formula="[scope_key]=[Parameters].[Scope] AND [role_selection]=[Parameters].[Role]" class="tableau" />
            </column>
            <column-instance column="[Selected slice]" derivation="None" name="[none:Selected slice:nk]" pivot="key" type="nominal" />
            <column caption="Skill top twelve" datatype="boolean" name="[Skill top twelve]" role="dimension" type="nominal">
              <calculation formula="[category_order]&lt;=12 AND [comparison_allowed]=1" class="tableau" />
            </column>
            <column-instance column="[Skill top twelve]" derivation="None" name="[none:Skill top twelve:nk]" pivot="key" type="nominal" />
            <column caption="Selected geography" datatype="boolean" name="[Selected geography]" role="dimension" type="nominal">
              <calculation formula="[category_type]=[Parameters].[Geography view] AND [category_order]&lt;=15" class="tableau" />
            </column>
            <column-instance column="[Selected geography]" derivation="None" name="[none:Selected geography:nk]" pivot="key" type="nominal" />
            <column caption="Display rate" datatype="real" name="[Display rate]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation formula="IF MIN([comparison_allowed])=1 AND MAX([denominator])&gt;0 THEN SUM([numerator])/MAX([denominator]) END" class="tableau" />
            </column>
            <column-instance column="[Display rate]" derivation="User" name="[usr:Display rate:qk]" pivot="key" type="quantitative" />
            <column caption="Count and denominator" datatype="string" name="[Count and denominator]" role="measure" type="nominal">
              <calculation formula="STR(SUM([numerator])) + &quot; / &quot; + STR(MAX([denominator])) + IF MIN([comparison_allowed])=0 THEN &quot; — comparison suppressed&quot; ELSE IF MAX([denominator])=0 THEN &quot; — unavailable&quot; ELSE &quot; (&quot; + STR(ROUND(100*SUM([numerator])/MAX([denominator]),1)) + &quot;%)&quot; END END" class="tableau" />
            </column>
            <column-instance column="[Count and denominator]" derivation="User" name="[usr:Count and denominator:nk]" pivot="key" type="nominal" />
            <column caption="Skill coverage message" datatype="string" name="[Skill coverage message]" role="measure" type="nominal">
              <calculation formula="IF SUM([numerator])&lt;10 THEN &quot;Skill comparisons suppressed: fewer than 10 usable lists. n=&quot; ELSE &quot;Usable inherited lists: n=&quot; END + STR(SUM([numerator])) + &quot; / &quot; + STR(MAX([denominator]))" class="tableau" />
            </column>
            <column-instance column="[Skill coverage message]" derivation="User" name="[usr:Skill coverage message:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Scope" datatype="string" name="[Scope]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Bay Area&quot;">
              <calculation formula="&quot;All Bay Area&quot;" class="tableau" />
