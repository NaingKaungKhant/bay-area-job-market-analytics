            <column datatype="string" name="[category_type]" role="dimension" type="nominal" />
            <column-instance column="[category_type]" derivation="None" name="[none:category_type:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[category]" role="dimension" type="nominal" />
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal" />
            <column datatype="integer" name="[numerator]" role="measure" type="quantitative" aggregation="Sum" />
            <column-instance column="[numerator]" derivation="Sum" name="[sum:numerator:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[denominator]" role="measure" type="quantitative" aggregation="Max" />
            <column-instance column="[denominator]" derivation="Max" name="[max:denominator:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[comparison_allowed]" role="dimension" type="nominal" />
            <column-instance column="[comparison_allowed]" derivation="None" name="[none:comparison_allowed:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[warning]" role="dimension" type="nominal" />
            <column-instance column="[warning]" derivation="None" name="[none:warning:nk]" pivot="key" type="nominal" />
