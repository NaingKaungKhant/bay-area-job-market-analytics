            <column-instance column="[scope_key]" derivation="None" name="[none:scope_key:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[role_selection]" role="dimension" type="nominal" />
            <column-instance column="[role_selection]" derivation="None" name="[none:role_selection:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[panel]" role="dimension" type="nominal" />
