      <aliases enabled="yes" />
      <column datatype="string" name="[scope_key]" role="dimension" type="nominal" />
      <column datatype="string" name="[role_selection]" role="dimension" type="nominal" />
      <column datatype="string" name="[panel]" role="dimension" type="nominal" />
      <column datatype="string" name="[category_type]" role="dimension" type="nominal" />
      <column datatype="string" name="[category]" role="dimension" type="nominal" />
      <column datatype="integer" name="[numerator]" role="measure" type="quantitative" aggregation="Sum" />
      <column datatype="integer" name="[denominator]" role="measure" type="quantitative" aggregation="Max" />
      <column datatype="integer" name="[comparison_allowed]" role="dimension" type="nominal" />
      <column datatype="string" name="[warning]" role="dimension" type="nominal" />
      <column datatype="integer" name="[category_order]" role="dimension" type="nominal" />
      <column datatype="real" name="[rate]" role="measure" type="quantitative" aggregation="Max" default-format="p0.0%" />
      <column datatype="string" name="[source_revision]" role="dimension" type="nominal" />
      <column datatype="string" name="[cleaning_rule_version]" role="dimension" type="nominal" />
      <column caption="Selected slice" datatype="boolean" name="[Selected slice]" role="dimension" type="nominal">
        <calculation formula="[scope_key]=[Parameters].[Scope] AND [role_selection]=[Parameters].[Role]" class="tableau" />
      </column>
      <column caption="Skill top twelve" datatype="boolean" name="[Skill top twelve]" role="dimension" type="nominal">
        <calculation formula="[category_order]&lt;=12 AND [comparison_allowed]=1" class="tableau" />
      </column>
      <column caption="Selected geography" datatype="boolean" name="[Selected geography]" role="dimension" type="nominal">
        <calculation formula="[category_type]=[Parameters].[Geography view] AND [category_order]&lt;=15" class="tableau" />
      </column>
      <column caption="Display rate" datatype="real" name="[Display rate]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation formula="IF MIN([comparison_allowed])=1 AND MAX([denominator])&gt;0 THEN SUM([numerator])/MAX([denominator]) END" class="tableau" />
      </column>
      <column caption="Count and denominator" datatype="string" name="[Count and denominator]" role="measure" type="nominal">
        <calculation formula="STR(SUM([numerator])) + &quot; / &quot; + STR(MAX([denominator])) + IF MIN([comparison_allowed])=0 THEN &quot; — comparison suppressed&quot; ELSE IF MAX([denominator])=0 THEN &quot; — unavailable&quot; ELSE &quot; (&quot; + STR(ROUND(100*SUM([numerator])/MAX([denominator]),1)) + &quot;%)&quot; END END" class="tableau" />
      </column>
      <column caption="Skill coverage message" datatype="string" name="[Skill coverage message]" role="measure" type="nominal">
        <calculation formula="IF SUM([numerator])&lt;10 THEN &quot;Skill comparisons suppressed: fewer than 10 usable lists. n=&quot; ELSE &quot;Usable inherited lists: n=&quot; END + STR(SUM([numerator])) + &quot; / &quot; + STR(MAX([denominator]))" class="tableau" />
      </column>
      <layout dim-ordering="alphabetic" measure-ordering="alphabetic" />
    </datasource>
